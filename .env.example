# PORT config
PORT=5000

# Secure third-party integrations (never exposed to front-end JavaScript bundles)
SECURE_CRM_KEY=your_salesforce_or_hubspot_api_key_here
SECURE_DB_URL=your_secure_database_connection_url_here

# Supabase Credentials
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SMTP Configuration for Email Notifications
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_user_email_here
SMTP_PASS=your_smtp_password_here
